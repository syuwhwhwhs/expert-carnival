{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "novamail",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "vars": {
    "MAIL_API": "https://api.mail.tm"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "novamail-db",
      "database_id": "ba24b2f8-9b8a-4c5d-89f4-19da4c80a654"
    }
  ]
}
